<div class="min-h-screen bg-slate-900 text-white flex flex-col items-center justify-center p-4">
  <div class="w-full max-w-xxl bg-slate-800 rounded-2xl shadow-xl p-6 border border-slate-700">

    <!-- Error Banner -->
    <div *ngIf="errorMessage" class="bg-red-500/20 border border-red-500 text-red-300 p-3 rounded-lg mb-4 text-sm">
      {{ errorMessage }}
    </div>

    <!-- Weather Display Card -->
    <div *ngIf="weatherData; else loading">
      <div class="text-center">
        <h1 class="text-3xl font-bold mb-1">{{ weatherData.city }}</h1>
        <p class="text-slate-400 text-sm mb-6">{{ weatherData.date }}</p>

        <!-- Temp Range Grid -->
        <div class="grid grid-cols-2 gap-4 my-6 p-4 bg-slate-900/50 rounded-xl border border-slate-700/50">
          <div class="text-center border-r border-slate-700">
            <span class="text-xs uppercase text-slate-400 font-bold block mb-1">Min Temp</span>
            <span class="text-3xl font-extrabold text-blue-400">{{ weatherData.minTemp }}°C</span>
          </div>
          <div class="text-center">
            <span class="text-xs uppercase text-slate-400 font-bold block mb-1">Max Temp</span>
            <span class="text-3xl font-extrabold text-amber-400">{{ weatherData.maxTemp }}°C</span>
          </div>
        </div>

        <!-- Hourly Forecast Array -->
        <div *ngIf="weatherData.hourlyTemps && weatherData.hourlyTemps.length > 0" class="mt-4">
          <span class="text-xs text-slate-400 uppercase font-bold block mb-2 text-left">Hourly Reading</span>
          <div class="flex gap-2 overflow-x-auto pb-2">
            <div *ngFor="let temp of weatherData.hourlyTemps; let i = index" class="bg-slate-700/50 px-3 py-2 rounded-lg text-sm font-semibold text-slate-200 border border-slate-600">
              #{{ i + 1 }}: {{ temp }}°C
            </div>
          </div>
        </div>

        <!-- ⚡ NEW GRAPH COMPONENT GOES HERE! ⚡ -->
        <app-weather-graph
          *ngIf="weatherData.hourlyTemps"
          [hourlyTemps]="weatherData.hourlyTemps">
        </app-weather-graph>

      </div>
    </div>

    <!-- Loading State -->
    <ng-template #loading>
      <div class="text-center text-slate-400 py-8">
        Scanning sky... 🌩️
      </div>
    </ng-template>

  </div>
</div>
